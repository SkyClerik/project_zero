<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement picking-mode="Ignore" name="window_area" style="flex-grow: 0; flex-direction: row; display: flex; align-items: center; justify-content: flex-end; background-color: rgba(0, 0, 0, 0.21); height: 100%; width: 100%;">
        <ui:VisualElement name="job_area" picking-mode="Ignore" style="flex-grow: 0; width: 97%; height: 100%; flex-direction: row;">
            <ui:VisualElement picking-mode="Ignore" name="main_insets_area" style="flex-grow: 0; width: 160px; align-items: center; justify-content: space-around;">
                <ui:Button text="Inventory" parse-escape-sequences="true" display-tooltip-when-elided="true" name="b_inventory" class="button-style-a" style="width: 160px; height: 160px; align-items: auto;" />
                <ui:Button text="Journal" parse-escape-sequences="true" display-tooltip-when-elided="true" name="b_journal" class="button-style-a" style="width: 160px; height: 160px;" />
                <ui:Button text="Settings" parse-escape-sequences="true" display-tooltip-when-elided="true" name="b_settings" class="button-style-a" style="width: 160px; height: 160px;" />
                <ui:Button text="Close" parse-escape-sequences="true" display-tooltip-when-elided="true" name="b_close" class="button-style-a" style="width: 160px; height: 160px;" />
            </ui:VisualElement>
            <ui:VisualElement picking-mode="Ignore" style="flex-grow: 1;">
                <ui:VisualElement picking-mode="Ignore" name="top_panel" style="flex-grow: 0; height: 7%; flex-direction: row; align-items: center; justify-content: space-between; background-color: rgba(59, 36, 113, 0.62);">
                    <ui:VisualElement picking-mode="Ignore" name="left_area" style="flex-grow: 0; height: 100%; width: 600px; flex-direction: row;">
                        <ui:VisualElement picking-mode="Ignore" style="flex-grow: 1; flex-direction: row;">
                            <ui:Label tabindex="-1" text="LEVEL" parse-escape-sequences="true" display-tooltip-when-elided="true" name="player_level" picking-mode="Ignore" style="height: 100%; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 40px; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; -unity-text-align: middle-center; white-space: normal; font-size: 40px; -unity-font-style: bold; color: rgb(185, 185, 185);" />
                            <ui:Label tabindex="-1" text="22" parse-escape-sequences="true" display-tooltip-when-elided="true" name="player_level_value" picking-mode="Ignore" style="height: 100%; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 10px; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; -unity-text-align: middle-center; white-space: normal; font-size: 40px; -unity-font-style: bold; color: rgb(185, 185, 185);" />
                        </ui:VisualElement>
                        <ui:VisualElement picking-mode="Ignore" style="flex-grow: 1; flex-direction: row;">
                            <ui:Label tabindex="-1" text="R" parse-escape-sequences="true" display-tooltip-when-elided="true" name="player_money" picking-mode="Ignore" style="height: 100%; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 40px; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; -unity-text-align: middle-center; white-space: normal; font-size: 40px; -unity-font-style: bold; color: rgb(185, 185, 185);" />
                            <ui:Label tabindex="-1" text="224524" parse-escape-sequences="true" display-tooltip-when-elided="true" name="player_money_value" picking-mode="Ignore" style="height: 100%; margin-top: 0; margin-right: 40px; margin-bottom: 0; margin-left: 10px; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; -unity-text-align: middle-center; white-space: normal; font-size: 40px; -unity-font-style: bold; color: rgb(185, 185, 185);" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement picking-mode="Ignore" name="right_area" style="flex-grow: 0; height: 100%; width: 600px; flex-direction: row; justify-content: flex-end;">
                        <ui:VisualElement name="battery" picking-mode="Ignore" style="flex-grow: 1; flex-direction: row; align-items: center;">
                            <ui:VisualElement name="battery_icon" picking-mode="Ignore" style="flex-grow: 0; background-image: url(&quot;project://database/Assets/SkyClerik/Images/Inventory/battary.png?fileID=21300000&amp;guid=2496b9486ea4f6c44891f9a6a807c94e&amp;type=3#battary&quot;); width: 96px; height: 96px;" />
                            <ui:Label tabindex="-1" text="100" parse-escape-sequences="true" display-tooltip-when-elided="true" name="value" picking-mode="Ignore" style="height: 96px; font-size: 46px; -unity-font-style: bold; color: rgb(223, 147, 21); -unity-text-align: middle-right; padding-top: 0; padding-right: 4px; padding-bottom: 0; padding-left: 0; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; width: 96px;" />
                            <ui:Label tabindex="-1" text="%" parse-escape-sequences="true" display-tooltip-when-elided="true" name="value" picking-mode="Ignore" style="width: 96px; height: 96px; font-size: 46px; -unity-font-style: bold; color: rgb(223, 147, 21); -unity-text-align: middle-left; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 4px;" />
                        </ui:VisualElement>
                        <ui:VisualElement picking-mode="Ignore" name="date_time" style="flex-grow: 1; flex-direction: column; align-items: center; justify-content: flex-end;">
                            <ui:VisualElement picking-mode="Ignore" style="flex-grow: 1; flex-direction: row;">
                                <ui:Label tabindex="-1" text="6" parse-escape-sequences="true" display-tooltip-when-elided="true" picking-mode="Ignore" name="data_value" style="height: 100%; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; -unity-text-align: middle-center; white-space: normal; font-size: 40px; -unity-font-style: bold; color: rgb(185, 185, 185);" />
                                <ui:Label tabindex="-1" text="March" parse-escape-sequences="true" display-tooltip-when-elided="true" picking-mode="Ignore" name="data_time_martch" style="height: 100%; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 20px; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; -unity-text-align: middle-center; white-space: normal; font-size: 40px; -unity-font-style: bold; color: rgb(185, 185, 185);" />
                            </ui:VisualElement>
                            <ui:VisualElement picking-mode="Ignore" style="flex-grow: 1;">
                                <ui:Label tabindex="-1" text="02:20" parse-escape-sequences="true" display-tooltip-when-elided="true" picking-mode="Ignore" name="time_value" style="height: 100%; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 20px; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; -unity-text-align: middle-center; white-space: normal; font-size: 40px; -unity-font-style: bold; color: rgb(185, 185, 185);" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement picking-mode="Ignore" name="space" class="hologram-panel" style="flex-grow: 1; background-color: rgb(60, 60, 60); flex-shrink: 1; justify-content: flex-start;" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
